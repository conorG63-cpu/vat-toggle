// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Shop {
  id          String       @id @default(cuid())
  shopDomain  String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  vatSettings VatSettings?
  vatRates    VatMarketRate[]
  translations VatTranslation[]
}

model VatSettings {
  id                    String    @id @default(cuid())
  shopId                String    @unique
  shop                  Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  defaultDisplayMode    String    @default("inclusive")
  defaultVatRate        Float     @default(20)
  showPopupOnFirstVisit Boolean   @default(true)
  togglePosition        String    @default("header")
  inclusiveLabel        String    @default("Inc. VAT")
  exclusiveLabel        String    @default("Ex. VAT")
  popupTitle            String    @default("How would you like to see prices?")
  popupMessage          String    @default("Choose your preferred pricing display")
  enableB2BMode         Boolean   @default(false)
  b2bCustomerTags       String    @default("b2b,wholesale,trade")
  b2bDefaultMode        String    @default("exclusive")
  vatRates              Json?
  toggleStyle           String    @default("pill")
  primaryColor          String    @default("#000000")
  backgroundColor       String    @default("#f4f4f4")
  activeTextColor       String    @default("#ffffff")
  borderRadius          String    @default("medium")
  showVatIndicator      Boolean   @default(true)
  indicatorPosition     String    @default("after")
  animationStyle        String    @default("smooth")
  settingsVersion       Int       @default(1)
  widgetPosition        String    @default("bottom-right")
  desktopOffsetX        Int       @default(24)
  desktopOffsetY        Int       @default(24)
  mobileOffsetX         Int       @default(16)
  mobileOffsetY         Int       @default(80)
  widgetPadding         Int       @default(12)
  controlSize           String    @default("medium")
  widgetBorderWidth     Int       @default(0)
  widgetBorderColor     String    @default("#e1e3e5")
  widgetShadow          String    @default("medium")
  allowMinimize         Boolean   @default(true)
  helperTextSize        String    @default("medium")
  helperTextColor       String    @default("#6d7175")
  popupChoiceDays       Int       @default(30)
  popupWidth            Int       @default(420)
  popupBackgroundColor  String    @default("#ffffff")
  popupOverlayColor     String    @default("#000000")
  popupOverlayOpacity   Int       @default(55)
  popupBorderRadius     String    @default("medium")
  popupTitleColor       String    @default("#202223")
  popupTextColor        String    @default("#616161")
  popupButtonStyle      String    @default("solid")
  popupShowClose        Boolean   @default(true)
  setupCompleted        Boolean   @default(false)
  activated             Boolean   @default(false)
  activatedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model VatMarketRate {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  marketId  String
  marketName String
  countryCode String
  rate      Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopId, marketId, countryCode])
}

model VatTranslation {
  id             String   @id @default(cuid())
  shopId         String
  shop           Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  locale         String
  inclusiveLabel String
  exclusiveLabel String
  popupTitle     String
  popupMessage   String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([shopId, locale])
}
