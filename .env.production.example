# Public application URL. DNS must point at the Lightsail static IP before Caddy starts.
APP_DOMAIN=app.example.com

# PostgreSQL is only reachable by the app container.
POSTGRES_DB=priceswitch
POSTGRES_USER=priceswitch
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Existing Shopify credentials. Do not commit the completed .env file.
SHOPIFY_API_KEY=replace-with-your-shopify-api-key
SHOPIFY_API_SECRET=replace-with-your-shopify-api-secret
SHOPIFY_APP_URL=https://app.example.com
SCOPES=read_products,read_markets,read_locales,read_themes,write_themes,read_orders,read_customers,write_customers,unauthenticated_read_customer_tags,write_app_proxy
